<Project Sdk="Microsoft.NET.Sdk">

  <!-- Google sign-in and the Google Calendar API (plain REST + System.Text.Json), mapped to the Core model. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dayflower.Core\Dayflower.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    The OAuth client comes from google-oauth.local.props (local builds) or environment variables (CI release
    builds); see docs/google-cloud-setup.md. Builds without one still work, but can't sign in.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="GoogleOAuthClientId" Value="$(GoogleOAuthClientId)" />
    <AssemblyMetadata Include="GoogleOAuthClientSecret" Value="$(GoogleOAuthClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dayflower.Providers.Google.Tests" />
  </ItemGroup>

</Project>
