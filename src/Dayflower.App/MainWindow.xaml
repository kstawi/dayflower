<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dayflower.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dayflower"
    xmlns:views="using:Dayflower.Views"
    xmlns:vm="using:Dayflower.ViewModels"
    Title="Dayflower">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Dayflower"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="280"
                    MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    PlaceholderText="Search events"
                    QueryIcon="Find" />
            </TitleBar.Content>
        </TitleBar>

        <SplitView
            x:Name="SidePane"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="True"
            OpenPaneLength="312"
            PaneBackground="Transparent">

            <SplitView.Pane>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,0,8,16" Spacing="24">
                        <CalendarView
                            x:Name="MiniMonth"
                            Width="296"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionMode="Single"
                            SelectedDatesChanged="MiniMonth_SelectedDatesChanged">
                            <CalendarView.Resources>
                                <!-- The default 12px side padding leaves too little room, so "Mo" and "We" wrap. -->
                                <Thickness x:Key="CalendarViewWeekDayPadding">0</Thickness>
                            </CalendarView.Resources>
                        </CalendarView>

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource PaneHeaderTextStyle}" Text="Calendars" />
                                <Button
                                    x:Name="AddAccountIconButton"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Add account"
                                    Command="{x:Bind Accounts.AddAccountCommand}"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTipService.ToolTip="Add account"
                                    Visibility="{x:Bind Accounts.HasAccounts, Mode=OneWay}">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                            </Grid>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="{x:Bind Accounts.IsSigningIn, Mode=OneWay}"
                                Visibility="{x:Bind Accounts.IsSigningIn, Mode=OneWay}"
                                Message="Pick your Google account there. Dayflower is waiting."
                                Severity="Informational"
                                Title="Continue in your browser">
                                <InfoBar.ActionButton>
                                    <Button Command="{x:Bind Accounts.CancelSignInCommand}" Content="Cancel" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <InfoBar
                                x:Name="AccountMessage"
                                IsOpen="{x:Bind Accounts.HasMessage, Mode=TwoWay}"
                                Visibility="{x:Bind Accounts.HasMessage, Mode=OneWay}"
                                Message="{x:Bind Accounts.Message, Mode=OneWay}"
                                Severity="{x:Bind Accounts.MessageSeverity, Mode=OneWay}"
                                Title="{x:Bind Accounts.MessageTitle, Mode=OneWay}" />

                            <StackPanel Spacing="8" Visibility="{x:Bind Accounts.HasNoAccounts, Mode=OneWay}">
                                <TextBlock Style="{StaticResource PaneHintTextStyle}" Text="Add a Google account to see its calendars here." />
                                <Button
                                    x:Name="AddAccountButton"
                                    Margin="4,4,0,0"
                                    Command="{x:Bind Accounts.AddAccountCommand}"
                                    IsEnabled="{x:Bind local:MainWindow.Not(Accounts.IsSigningIn), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                                        <TextBlock Text="Add account" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ItemsControl x:Name="AccountList" ItemsSource="{x:Bind Accounts.Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                                        <StackPanel Margin="0,0,0,12" Spacing="2">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Email}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="{x:Bind Email}"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    ToolTipService.ToolTip="Account options">
                                                    <FontIcon FontSize="12" Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuFlyoutItem Command="{x:Bind SignInAgainCommand}" Text="Sign in again">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE72C;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Command="{x:Bind RemoveCommand}" Text="Remove account">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>

                                            <InfoBar
                                                IsClosable="False"
                                                IsOpen="{x:Bind NeedsSignIn}"
                                                Visibility="{x:Bind NeedsSignIn}"
                                                Message="Google stopped accepting this account's saved sign-in."
                                                Severity="Warning"
                                                Title="Sign in again">
                                                <InfoBar.ActionButton>
                                                    <Button Command="{x:Bind SignInAgainCommand}" Content="Sign in" />
                                                </InfoBar.ActionButton>
                                            </InfoBar>

                                            <ItemsControl ItemsSource="{x:Bind Calendars}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                                        <CheckBox
                                                            MinWidth="0"
                                                            Margin="4,0,0,0"
                                                            AutomationProperties.Name="{x:Bind Name}"
                                                            IsChecked="{x:Bind IsVisible, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border
                                                                    Width="12"
                                                                    Height="12"
                                                                    VerticalAlignment="Center"
                                                                    Background="{x:Bind local:XamlHelpers.Brush(Color)}"
                                                                    CornerRadius="3" />
                                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PaneHeaderTextStyle}" Text="Time zones" />
                            <TextBlock Style="{StaticResource PaneHintTextStyle}" Text="Clocks for the time zones you pick will show here." />
                        </StackPanel>

                        <TextBlock
                            x:Name="SyncStatusText"
                            Style="{StaticResource PaneHintTextStyle}"
                            Text="{x:Bind Accounts.SyncStatus, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <!-- The content area sits on a layer above Mica, like the content of Windows Settings. -->
            <Grid
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,12,16,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New event" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="TodayButton"
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.GoToTodayCommand}"
                        Content="Today" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button
                            x:Name="PreviousPeriodButton"
                            AutomationProperties.Name="Previous"
                            Command="{x:Bind ViewModel.GoToPreviousCommand}"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="Previous">
                            <FontIcon FontSize="14" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            x:Name="NextPeriodButton"
                            AutomationProperties.Name="Next"
                            Command="{x:Bind ViewModel.GoToNextCommand}"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="Next">
                            <FontIcon FontSize="14" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="PeriodTitle"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <SelectorBar
                        x:Name="ViewSwitcher"
                        Grid.Column="4"
                        SelectionChanged="ViewSwitcher_SelectionChanged">
                        <SelectorBarItem Tag="Day" Text="Day" />
                        <SelectorBarItem Tag="Week" Text="Week" />
                        <SelectorBarItem Tag="Month" Text="Month" />
                        <SelectorBarItem Tag="Agenda" Text="Agenda" />
                    </SelectorBar>
                </Grid>

                <views:TimeGridView
                    x:Name="TimeGrid"
                    Grid.Row="1"
                    Margin="8,0,8,0"
                    DayClicked="View_DayClicked"
                    ItemClicked="View_ItemClicked"
                    JoinClicked="View_JoinClicked"
                    Visibility="Collapsed" />

                <views:MonthView
                    x:Name="MonthGrid"
                    Grid.Row="1"
                    Margin="16,0,16,16"
                    DayClicked="View_DayClicked"
                    ItemClicked="View_ItemClicked"
                    Visibility="Collapsed" />

                <views:AgendaView
                    x:Name="AgendaList"
                    Grid.Row="1"
                    Margin="8,0,8,0"
                    ItemClicked="View_ItemClicked"
                    Visibility="Collapsed" />

                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="1"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind Accounts.HasNoAccounts, Mode=OneWay}">
                    <FontIcon
                        Margin="0,0,0,8"
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE787;" />
                    <TextBlock
                        x:Name="CacheTitleText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Accounts.CacheTitle, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Accounts.CacheDetail, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </SplitView>
    </Grid>
</Window>
