<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dayflower.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dayflower"
    xmlns:views="using:Dayflower.Views"
    xmlns:vm="using:Dayflower.ViewModels"
    Title="Dayflower">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- No icon or name: the pane button and a centred search box, with room around it to drag the window. -->
        <TitleBar
            x:Name="AppTitleBar"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <!-- The content area spans the bar; the window places the search box centred on the whole window. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Loaded="SearchBox_Loaded"
                    Width="440"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.LandmarkType="Search"
                    AutomationProperties.Name="Search events"
                    IsEnabled="{x:Bind Accounts.HasAccounts, Mode=OneWay}"
                    PlaceholderText="Search events (Ctrl+F)"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="views:SearchSuggestion">
                            <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{x:Bind ColorBrush}" CornerRadius="2" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind When}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <!-- The side pane and the content. Opening and closing animate the pane's column, so the content resizes together
             with the pane instead of jumping to its final width first. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PaneColumn" Width="312" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sync status and Settings stay at the bottom; everything above scrolls when there are many calendars. -->
            <Grid
                x:Name="SidePane"
                Width="312"
                HorizontalAlignment="Right"
                AutomationProperties.LandmarkType="Navigation"
                AutomationProperties.Name="Side pane">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    x:Name="PaneScroller"
                    SizeChanged="PaneScroller_SizeChanged"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,0,8,16" SizeChanged="PaneScroller_SizeChanged" Spacing="24">
                        <CalendarView
                            x:Name="MiniMonth"
                            Width="296"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionMode="Single"
                            SelectedDatesChanged="MiniMonth_SelectedDatesChanged">
                            <CalendarView.Resources>
                                <!-- The default 12px side padding leaves too little room, so "Mo" and "We" wrap. -->
                                <Thickness x:Key="CalendarViewWeekDayPadding">0</Thickness>
                            </CalendarView.Resources>
                        </CalendarView>

                        <views:WorldClockView x:Name="WorldClockPanel" />

                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource PaneHeaderTextStyle}"
                                    Text="Calendars" />
                                <Button
                                    x:Name="AddAccountIconButton"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Add account"
                                    Command="{x:Bind Accounts.AddAccountCommand}"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTipService.ToolTip="Add account"
                                    Visibility="{x:Bind Accounts.HasAccounts, Mode=OneWay}">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                            </Grid>

                            <InfoBar
                                IsClosable="False"
                                IsOpen="{x:Bind Accounts.IsSigningIn, Mode=OneWay}"
                                Visibility="{x:Bind Accounts.IsSigningIn, Mode=OneWay}"
                                Message="Pick your Google account there. Dayflower is waiting."
                                Severity="Informational"
                                Title="Continue in your browser">
                                <InfoBar.ActionButton>
                                    <Button Command="{x:Bind Accounts.CancelSignInCommand}" Content="Cancel" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <InfoBar
                                x:Name="AccountMessage"
                                IsOpen="{x:Bind Accounts.HasMessage, Mode=TwoWay}"
                                Visibility="{x:Bind Accounts.HasMessage, Mode=OneWay}"
                                Message="{x:Bind Accounts.Message, Mode=OneWay}"
                                Severity="{x:Bind Accounts.MessageSeverity, Mode=OneWay}"
                                Title="{x:Bind Accounts.MessageTitle, Mode=OneWay}" />

                            <StackPanel Spacing="8" Visibility="{x:Bind Accounts.HasNoAccounts, Mode=OneWay}">
                                <TextBlock Style="{StaticResource PaneHintTextStyle}" Text="Add a Google account to see its calendars here." />
                                <Button
                                    x:Name="AddAccountButton"
                                    Margin="4,4,0,0"
                                    Command="{x:Bind Accounts.AddAccountCommand}"
                                    IsEnabled="{x:Bind local:MainWindow.Not(Accounts.IsSigningIn), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                                        <TextBlock Text="Add account" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ItemsControl x:Name="AccountList" ItemsSource="{x:Bind Accounts.Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                                        <StackPanel Margin="0,0,0,12" Spacing="2">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Email}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="{x:Bind Email}"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    ToolTipService.ToolTip="Account options">
                                                    <FontIcon FontSize="12" Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuFlyoutItem Command="{x:Bind SignInAgainCommand}" Text="Sign in again">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE72C;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Command="{x:Bind RemoveCommand}" Text="Remove account">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>

                                            <InfoBar
                                                IsClosable="False"
                                                IsOpen="{x:Bind NeedsSignIn}"
                                                Visibility="{x:Bind NeedsSignIn}"
                                                Message="Google stopped accepting this account's saved sign-in."
                                                Severity="Warning"
                                                Title="Sign in again">
                                                <InfoBar.ActionButton>
                                                    <Button Command="{x:Bind SignInAgainCommand}" Content="Sign in" />
                                                </InfoBar.ActionButton>
                                            </InfoBar>

                                            <ItemsControl ItemsSource="{x:Bind Calendars}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                                        <CheckBox
                                                            MinWidth="0"
                                                            Margin="4,0,0,0"
                                                            AutomationProperties.Name="{x:Bind Name}"
                                                            IsChecked="{x:Bind IsVisible, Mode=TwoWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border
                                                                    Width="12"
                                                                    Height="12"
                                                                    VerticalAlignment="Center"
                                                                    Background="{x:Bind local:XamlHelpers.Brush(Color)}"
                                                                    CornerRadius="3" />
                                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel
                    x:Name="PaneFooter"
                    Grid.Row="1"
                    Padding="8,8,8,12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Spacing="4">
                    <TextBlock
                        x:Name="SyncStatusText"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PaneHintTextStyle}"
                        Text="{x:Bind Accounts.SyncStatus, Mode=OneWay}" />
                    <Button
                        x:Name="SettingsButton"
                        Margin="-4,0,0,0"
                        AutomationProperties.Name="Settings"
                        Click="SettingsButton_Click"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The content area sits on a layer above Mica, like the content of Windows Settings. -->
            <Grid
                x:Name="ContentArea"
                Grid.Column="1"
                AutomationProperties.LandmarkType="Main"
                AutomationProperties.Name="Calendar"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">

                <!-- The calendar; the Settings page takes its place when open. -->
                <Grid x:Name="CalendarContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="Toolbar" Padding="16,12,16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="NewEventButton"
                            AutomationProperties.Name="New event"
                            Click="NewEventButton_Click"
                            IsEnabled="{x:Bind Accounts.HasAccounts, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="New event (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="New event" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="TodayButton"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.GoToTodayCommand}"
                            Content="Today"
                            ToolTipService.ToolTip="Today (T)" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button
                                x:Name="PreviousPeriodButton"
                                AutomationProperties.Name="Previous"
                                Command="{x:Bind ViewModel.GoToPreviousCommand}"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                ToolTipService.ToolTip="Previous (Page Up)">
                                <FontIcon FontSize="14" Glyph="&#xE76B;" />
                            </Button>
                            <Button
                                x:Name="NextPeriodButton"
                                AutomationProperties.Name="Next"
                                Command="{x:Bind ViewModel.GoToNextCommand}"
                                Style="{StaticResource SubtleIconButtonStyle}"
                                ToolTipService.ToolTip="Next (Page Down)">
                                <FontIcon FontSize="14" Glyph="&#xE76C;" />
                            </Button>
                        </StackPanel>

                        <TextBlock
                            x:Name="PeriodTitle"
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <SelectorBar
                            x:Name="ViewSwitcher"
                            Grid.Column="4"
                            SelectionChanged="ViewSwitcher_SelectionChanged">
                            <SelectorBarItem Tag="Day" Text="Day" />
                            <SelectorBarItem Tag="Week" Text="Week" />
                            <SelectorBarItem Tag="Month" Text="Month" />
                            <SelectorBarItem Tag="Agenda" Text="Agenda" />
                        </SelectorBar>
                    </Grid>

                    <!-- Shows while a change is on its way to Google. -->
                    <ProgressBar
                        x:Name="SavingBar"
                        Margin="16,0,16,0"
                        VerticalAlignment="Bottom"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />

                    <views:TimeGridView
                        x:Name="TimeGrid"
                        Grid.Row="1"
                        Margin="8,0,8,0"
                        DayClicked="View_DayClicked"
                        ItemClicked="View_ItemClicked"
                        ItemMoved="View_ItemMoved"
                        JoinClicked="View_JoinClicked"
                        SlotSelected="View_SlotSelected"
                        Visibility="Collapsed" />

                    <views:MonthView
                        x:Name="MonthGrid"
                        Grid.Row="1"
                        Margin="16,0,16,16"
                        DayClicked="View_DayClicked"
                        ItemClicked="View_ItemClicked"
                        Visibility="Collapsed" />

                    <views:AgendaView
                        x:Name="AgendaList"
                        Grid.Row="1"
                        Margin="8,0,8,0"
                        ItemClicked="View_ItemClicked"
                        Visibility="Collapsed" />

                    <!-- Search results, in place of the calendar view while searching. -->
                    <Grid
                        x:Name="SearchPanel"
                        Grid.Row="1"
                        Margin="8,0,8,0"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="8,0,8,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SearchTitle"
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="CloseSearchButton"
                                Grid.Column="1"
                                Click="CloseSearchButton_Click"
                                Content="Back to calendar"
                                ToolTipService.ToolTip="Back to calendar (Esc)" />
                        </Grid>
                        <views:AgendaView
                            x:Name="SearchResults"
                            Grid.Row="1"
                            ItemClicked="View_ItemClicked" />
                    </Grid>

                    <StackPanel
                        x:Name="EmptyState"
                        Grid.Row="1"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind Accounts.HasNoAccounts, Mode=OneWay}">
                        <FontIcon
                            Margin="0,0,0,8"
                            FontSize="48"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE787;" />
                        <TextBlock
                            x:Name="CacheTitleText"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind Accounts.CacheTitle, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Accounts.CacheDetail, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SettingsHost" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
