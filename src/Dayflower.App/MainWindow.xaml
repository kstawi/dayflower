<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dayflower.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dayflower">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Dayflower"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MinWidth="280"
                    MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    PlaceholderText="Search events"
                    QueryIcon="Find" />
            </TitleBar.Content>
        </TitleBar>

        <SplitView
            x:Name="SidePane"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="True"
            OpenPaneLength="312"
            PaneBackground="Transparent">

            <SplitView.Pane>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,0,8,16" Spacing="24">
                        <CalendarView
                            x:Name="MiniMonth"
                            Width="296"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionMode="Single"
                            SelectedDatesChanged="MiniMonth_SelectedDatesChanged">
                            <CalendarView.Resources>
                                <!-- The default 12px side padding leaves too little room, so "Mo" and "We" wrap. -->
                                <Thickness x:Key="CalendarViewWeekDayPadding">0</Thickness>
                            </CalendarView.Resources>
                        </CalendarView>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PaneHeaderTextStyle}" Text="Calendars" />
                            <TextBlock Style="{StaticResource PaneHintTextStyle}" Text="Add a Google account to see its calendars here." />
                            <Button Margin="4,4,0,0" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                                    <TextBlock Text="Add account" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PaneHeaderTextStyle}" Text="Time zones" />
                            <TextBlock Style="{StaticResource PaneHintTextStyle}" Text="Clocks for the time zones you pick will show here." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <!-- The content area sits on a layer above Mica, like the content of Windows Settings. -->
            <Grid
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,12,16,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New event" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="TodayButton"
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.GoToTodayCommand}"
                        Content="Today" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button
                            x:Name="PreviousPeriodButton"
                            AutomationProperties.Name="Previous"
                            Command="{x:Bind ViewModel.GoToPreviousCommand}"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="Previous">
                            <FontIcon FontSize="14" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            x:Name="NextPeriodButton"
                            AutomationProperties.Name="Next"
                            Command="{x:Bind ViewModel.GoToNextCommand}"
                            Style="{StaticResource SubtleIconButtonStyle}"
                            ToolTipService.ToolTip="Next">
                            <FontIcon FontSize="14" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="PeriodTitle"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <SelectorBar
                        x:Name="ViewSwitcher"
                        Grid.Column="4"
                        SelectionChanged="ViewSwitcher_SelectionChanged">
                        <SelectorBarItem Tag="Day" Text="Day" />
                        <SelectorBarItem Tag="Week" Text="Week" />
                        <SelectorBarItem Tag="Month" Text="Month" />
                        <SelectorBarItem Tag="Agenda" Text="Agenda" />
                    </SelectorBar>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        Margin="0,0,0,8"
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE787;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Your calendar will show here" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Google sign-in is coming next." />
                </StackPanel>
            </Grid>
        </SplitView>
    </Grid>
</Window>
