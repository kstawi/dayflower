<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Development aid: inspects the app's local cache and checks it against Google, e.g. cache statistics and the
    recurrence audit (local expansion of repeating events compared with Google's own instances).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <AssemblyName>dayflower-dev</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dayflower.Core\Dayflower.Core.csproj" />
    <ProjectReference Include="..\..\src\Dayflower.Storage\Dayflower.Storage.csproj" />
    <ProjectReference Include="..\..\src\Dayflower.Providers.Google\Dayflower.Providers.Google.csproj" />
  </ItemGroup>

</Project>
